# Copy this file to `secrets.env` in the same folder and fill in the
# values below. The real `secrets.env` is gitignored and never leaves
# your computer — Claude sessions read it at the start of each session
# to authenticate to GitHub when pushing.
#
# Create a fine-grained GitHub token here:
#   https://github.com/settings/personal-access-tokens/new
#
# Scope it to just this repo (monosyth/monosyth) with:
#   - Contents: Read and write
#   - Metadata: Read-only (auto)
#
# Pick any expiry you like (90 days / 1 year / custom). When it
# expires, regenerate and paste the new value.

GITHUB_TOKEN=ghp_paste_your_token_here
